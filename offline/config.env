# Offline solver — configuration defaults.
# Copy to config.local.env and edit. Sourced by start.sh.
#
# Hardware baseline: Poco X6 Pro — Dimensity 8300-Ultra, 8+4 GB RAM,
# Mali-G615 MC6 (Vulkan), Android 15.

# ── models ──────────────────────────────────────────────────────────────────
# Download these WHILE YOU HAVE INTERNET. They live on the phone's storage
# and are loaded by llama-server on demand.

# The vision model reads the paper. Qwen2.5-VL-3B handles Cyrillic + math
# notation; MiniCPM-V is lighter but weaker on Russian.
OCR_MODEL="$HOME/models/qwen2.5-vl-3b-instruct-q4_k_m.gguf"

# The solver brain. Phi-4-mini-reasoning is built for math/logic/code —
# its job is translating problems into SymPy Python, not solving them itself.
SOLVER_MODEL="$HOME/models/phi-4-mini-reasoning-q4_k_m.gguf"

# ── llama-server ────────────────────────────────────────────────────────────
# Ports for each model's llama-server instance.
OCR_PORT=8081
SOLVER_PORT=8082

# Threads: 4 = the A715 big cores only. Using all 8 thermal-throttles in
# ~90s and makes the phone UI unresponsive.
LLAMA_THREADS=4

# GPU layers to offload to Mali-G615 via Vulkan. Partial offload (20-25
# layers) gets GPU acceleration on attention without claiming so much of
# the shared memory pool that the other model can't load.
# Set to 0 to disable GPU entirely (CPU-only, slower but safer on RAM).
OCR_GPU_LAYERS=20
SOLVER_GPU_LAYERS=20

# Context window. OCR: a page of LaTeX fits in 2k. Solver: problem +
# generated code + output fits in 4k. Larger = more RAM per token.
OCR_CONTEXT=2048
SOLVER_CONTEXT=4096

# Batch size. Lower = less peak RAM spike during prompt processing.
LLAMA_BATCH=256

# Whether to load both models simultaneously (needs ~4.5 GB for weights
# alone — only safe on the 12 GB variant) or swap them sequentially.
#   sequential  load OCR → run → unload → load solver → run → unload
#   parallel    both llama-servers stay up (faster, needs more RAM)
LOAD_MODE=sequential

# ── resource limits ─────────────────────────────────────────────────────────
# Minimum free RAM (MB) before loading a model. Protects Android from OOM.
MIN_FREE_MB=1200

# Thermal gates (°C). Inference pauses above THERMAL_PAUSE and resumes
# below THERMAL_RESUME. Prevents the SoC from throttling to 30% and
# making everything take 3x longer.
THERMAL_PAUSE=44
THERMAL_RESUME=39

# Process priority. 10 = reduced, keeps the phone UI responsive.
NICE_LEVEL=10

# ── timeouts ────────────────────────────────────────────────────────────────
# Per-frame OCR (seconds). If the VLM can't read a frame in this time, skip.
OCR_TIMEOUT=60

# Per-problem SymPy execution (seconds). Some integrals/series hang forever.
SYMPY_TIMEOUT=30

# Per-problem total: model generation + SymPy combined.
SOLVER_PROBLEM_TIMEOUT=90

# Whole pipeline ceiling. If the full assignment isn't solved in this time,
# submit what we have and give up on the rest.
TOTAL_TIMEOUT=600

# ── llama.cpp paths ─────────────────────────────────────────────────────────
# Where llama.cpp was built. setup-termux.sh puts it here.
LLAMA_DIR="$HOME/llama.cpp"
LLAMA_SERVER="$LLAMA_DIR/build/bin/llama-server"

# ── evens server ────────────────────────────────────────────────────────────
# Where the local evens/server listens (or the remote VPS when online).
EVENS_URL="http://localhost:8787"
SOLVER_TOKEN=""

# ── polling ─────────────────────────────────────────────────────────────────
# How often to check for a new run to solve (seconds). The backup solver on
# the VPS checks every 30s; this is the local equivalent.
POLL_INTERVAL=15

# How long after a run is created to wait before claiming it. Gives the
# cloud solver a chance to win when we're online.
GRACE_PERIOD=10

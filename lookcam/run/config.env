# Capture-box configuration. Sourced by run/capture.sh (and therefore by the
# Termux supervisor, phone/termux-run.sh). Edit THIS file — not the scripts.
#
#   cp run/config.env run/config.local.env   # optional: keep your secrets out of git
# capture.sh prefers config.local.env if it exists.
#
# Values use the ${VAR:-default} form, so an environment variable that is
# already set wins over the file:  MODE=h264 bash run/capture.sh

# ---- camera -----------------------------------------------------------------
# "auto" = find it by UID with discover.py on every (re)start. Use this on a
# phone hotspot / DHCP network where the camera's IP moves around.
# Or hardcode an IP (e.g. 10.158.133.99) if it's static.
CAMERA_IP="${CAMERA_IP:-auto}"
CAM_UID="${CAM_UID:-G683009DYDYB}"
CAM_PASS="${CAM_PASS:-12345678}"
STREAM="${STREAM:-1}"                         # 0=4K  1=2K/1080p  2=1080p

# Second physical camera, shared by BOTH pipelines below — each treats it as a
# genuine failover, not a second feed to show at the same time as the first:
#   capture.sh        prefers CAM_UID; only pushes CAM_UID_FALLBACK to the VPS
#                     when CAM_UID doesn't answer, and switches straight back
#                     once it does (see FAILOVER_RECHECK). Only takes effect
#                     with CAMERA_IP=auto — a hardcoded CAMERA_IP has nowhere
#                     to fail over TO.
#   dual_capture.sh   (offline) keeps a rolling local snapshot from each and
#                     offline/solver.py's GET /assignment/camera reads
#                     whichever is freshest — see _pick_camera_snapshot().
CAM_UID_FALLBACK="${CAM_UID_FALLBACK:-G272677TDYLE}"
# capture.sh only: how often (seconds) to check whether CAM_UID has come back
# while CAM_UID_FALLBACK is the one actually streaming. Empty CAM_UID_FALLBACK
# disables all of the above.
FAILOVER_RECHECK="${FAILOVER_RECHECK:-60}"

# ---- offline camera feed (local snapshot, no VPS) ---------------------------
# run/dual_capture.sh writes a rolling JPEG per camera here; offline/solver.py
# reads whichever is freshest. Independent of VPS_HOST/STREAM_KEY below, which
# are only for the online streaming pipeline (capture.sh).
SNAPSHOT_DIR="${SNAPSHOT_DIR:-$HOME/lookcam-snapshots}"
SNAPSHOT_FPS="${SNAPSHOT_FPS:-1}"

# ---- where to push ----------------------------------------------------------
VPS_HOST="${VPS_HOST:-even.aansl.com}"
STREAM_KEY="${STREAM_KEY:-cam1}"                # must match a path in vps/mediamtx.yml
PUBLISH_USER="${PUBLISH_USER:-publisher}"
PUBLISH_PASS="${PUBLISH_PASS:-CHANGE_ME_PUBLISH}" # must match mediamtx.yml authInternalUsers

# ---- mode -------------------------------------------------------------------
#  copy = push the camera's H.265 as-is over SRT. ~Zero CPU here → the right
#         choice on a PHONE (Termux) or any weak box. The VPS then transcodes
#         for browsers (vps/transcode.sh, installed by vps/install-transcode.sh).
#  h264 = transcode to H.264 here and push RTMP. No VPS-side CPU cost, but needs
#         a real CPU locally (laptop / Pi 4-5 / mini-PC).
MODE="${MODE:-copy}"

# ---- latency ----------------------------------------------------------------
# SRT receiver buffer, in MICROseconds. This is the window SRT has to retransmit
# a lost packet, so it is a direct trade: lower = less delay, but below roughly
# 3-4x the phone->VPS round-trip the retransmits stop landing in time and you
# get visible corruption instead. The phone's uplink here is MOBILE DATA, not
# the hotspot, so it is the most variable leg of the whole chain.
#
# Was 120000 (libsrt's default), which is what the docs suggest for a LAN. On
# mobile data that is far too tight: RTT is commonly 40-100ms with heavy jitter,
# so retransmits kept landing late, SRT dropped them, and the VPS decoder lost
# reference frames -> grey macroblocks in the picture and starved HLS parts,
# which stalled the player. 400ms costs ~280ms of deliberate buffer and buys
# back far more than that in stalls not taken.
#
# To tune it, measure the real RTT with `bash phone/rtt.sh` and set this to
# about 4x the reported median, with ~300000 as a sane floor. Note that ping is
# useless for this — the VPS drops ICMP, so it reports 100% loss on a link that
# is carrying video perfectly well; rtt.sh times a TCP handshake instead.
SRT_LATENCY="${SRT_LATENCY:-400000}"

# transcode quality — MODE=h264 only
FPS="${FPS:-15}"
CRF="${CRF:-20}"
MAXRATE="${MAXRATE:-5000k}"

# ---- discovery retry --------------------------------------------------------
DISCOVER_TIMEOUT="${DISCOVER_TIMEOUT:-5}"               # seconds to listen per broadcast attempt
DISCOVER_RETRY="${DISCOVER_RETRY:-10}"                # seconds between attempts while the cam is absent
# Extra broadcast address(es), space-separated. Rarely needed now: discover.py
# sends from a socket bound to each interface (so an Android hotspot's AP subnet
# is probed even though the phone's default route points at mobile data), and
# falls back to unicast-probing every host on the attached /24s when broadcast
# comes back empty. Set this only if the AP interface is missing from `ip addr`
# entirely. Android hotspot is normally 192.168.43.0/24 (some ROMs 192.168.1.0/24).
EXTRA_BROADCAST="${EXTRA_BROADCAST:-}"               # e.g. "192.168.43.255"

# Whole subnet(s) to probe AND unicast-sweep even if we hold no address there.
# The escape hatch for a phone whose AP interface is invisible to every
# enumeration method: name the camera's subnet outright. Check it with
# `bash phone/netdiag.sh`.
EXTRA_SUBNET="${EXTRA_SUBNET:-}"                     # e.g. "10.158.133.0/24"

# ---- liveness ---------------------------------------------------------------
# Every fault below this script turns into an exit, which is what makes the
# retry chain work — but a HANG produces no exit at all, and used to be
# invisible and permanent: a camera that answers discovery but never sends video
# left lookcam_stream.py alive and mute, ffmpeg blocked reading the fifo with no
# -timeout to save it, capture.sh blocked in `wait -n`, and the supervisor
# blocked on capture.sh while still holding the wake lock and the pidfile — so
# even a plain restart was refused and only a reboot or --force got out.
#
# capture.sh touches HEARTBEAT_FILE whenever it is demonstrably making progress
# (hunting for a camera, or ffmpeg reporting muxed video via -progress).
# PIPELINE_STALL is its own fast self-heal; phone/termux-run.sh watches the same
# file with a much longer HEARTBEAT_MAX as the catch-all backstop.
HEARTBEAT_FILE="${HEARTBEAT_FILE:-${HOME:-${TMPDIR:-/tmp}}/.lookcam.heartbeat}"
# Seconds without muxed video before the pipeline is declared hung and rebuilt.
# Doubles as the grace period for the first frame of each round, so keep it
# comfortably above login + OpenVideo + first keyframe (normally 2-5s). 0 = off.
PIPELINE_STALL="${PIPELINE_STALL:-45}"
HEARTBEAT_POLL="${HEARTBEAT_POLL:-5}"                # how often to check that

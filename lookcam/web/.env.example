# Copy to .env and edit. The gateway reads these at startup.
PORT=8080

# Password for the frontend (what YOU type to log in).
APP_PASSWORD=pick-a-good-password
# Long random string used to sign session cookies. Generate: openssl rand -hex 32
SESSION_SECRET=replace-with-openssl-rand-hex-32
SESSION_HOURS=720

# MediaMTX — keep it bound to localhost; the gateway reaches it here.
MTX_HOST=127.0.0.1
MTX_HLS_PORT=8888
MTX_PLAYBACK_PORT=9996
STREAM_PATH=cam1

# The read-only viewer credentials from mediamtx.yml (authInternalUsers).
MTX_VIEW_USER=viewer
MTX_VIEW_PASS=CHANGE_ME_VIEW

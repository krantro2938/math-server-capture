# VPS-side configuration, sourced by vps/transcode.sh.
# Copy to config.local.env and put your real passwords there (transcode.sh
# prefers config.local.env; that's the one to keep out of git).
#
# These must match vps/mediamtx.yml -> authInternalUsers and the capture box's
# run/config.env -> PUBLISH_PASS.
#
# Every value is written as ${VAR:-default} so an already-set environment
# variable wins. That's what lets the Docker stack pass credentials in from
# vps/docker/.env without editing (or baking) any file.

STREAM_KEY="${STREAM_KEY:-cam1}"
MTX_HOST="${MTX_HOST:-127.0.0.1}"

PUBLISH_USER="${PUBLISH_USER:-publisher}"
PUBLISH_PASS="${PUBLISH_PASS:-CHANGE_ME_PUBLISH}"
VIEW_USER="${VIEW_USER:-viewer}"
VIEW_PASS="${VIEW_PASS:-CHANGE_ME_VIEW}"

# H.264 output for browsers. 2000k is fine for 1080p15; raise for more detail.
BITRATE="${BITRATE:-2000k}"

# ---- latency ----------------------------------------------------------------
# GOP_SECONDS is the single most important latency knob in the whole stack.
# HLS can only start a segment on a keyframe, so the *encoder's* keyframe
# interval — not hlsSegmentDuration — sets the real segment length, and the
# player then sits some multiple of that behind live. Keep this equal to
# hlsSegmentDuration in vps/mediamtx.yml (1s). Raising it saves bitrate at a
# direct cost in latency.
GOP_SECONDS="${GOP_SECONDS:-1}"
# The camera is 1080p15. Only used to size the GOP in frames; keyframes are also
# forced on a time expression, so an inaccurate value here costs nothing.
FPS="${FPS:-15}"
# veryfast is the sane default. Slower presets buy quality per bit but add
# encode delay; do not use anything below "fast" on a small VPS.
PRESET="${PRESET:-veryfast}"

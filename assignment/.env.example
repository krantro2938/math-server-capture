# Copy to .env (docker compose reads it, or `bun --env-file=.env run server.ts`).

# ---- Gemini -----------------------------------------------------------------
GEMINI_API_KEY=              # REQUIRED — https://aistudio.google.com/apikey
# The model id is passed through verbatim. If Google answers 404 "model not
# found", change it here — nothing else depends on it.
# Known-good alternatives: gemini-2.5-flash-lite, gemini-2.5-flash
GEMINI_MODEL=gemini-3.5-flash-lite

# ---- where the frames come from ---------------------------------------------
# PREFERRED: ask the web gateway for a still. It owns stream access and the
# MediaMTX credentials, so this service only needs HTTP — it can even run on a
# different machine from the camera stack.
SNAPSHOT_URL=http://web:8080/api/snapshot.jpg
SNAPSHOT_TOKEN=            # must match SNAPSHOT_TOKEN in the gateway's env

# FALLBACK, used only when SNAPSHOT_URL is empty: grab from RTSP directly
# (needs ffmpeg in this container). MediaMTX is `mediamtx` on the compose
# network; the password is VIEW_PASS from vps/docker/.env.
RTSP_URL=rtsp://viewer:change-me-view@mediamtx:8554/cam1
GRAB_TIMEOUT_MS=20000

# ---- background job ---------------------------------------------------------
# POST /start runs captures until the model says the assignment is fully read.
INTERVAL_MS=1000       # pause between captures
MAX_CAPTURES=40        # hard ceiling per job — each capture is a paid API call,
                       # and a camera pointed at nothing never reaches "done"
MAX_FAILURES=5         # consecutive failed captures before the job gives up
AUTO_RESUME=1          # resume an interrupted job on restart (0 to disable)

# ---- this server ------------------------------------------------------------
PORT=8091
# Shared secret for every endpoint except /health. Each capture costs an API
# call, so don't leave this empty on a reachable port.
API_TOKEN=pick-a-long-random-token
DATA_DIR=./data

# Copy to .env — this is the ONLY file on the VPS holding secrets.
#   cp .env.example .env && nano .env
# Nothing else needs editing: mediamtx.yml keeps its CHANGE_ME placeholders and
# these values are injected over them at runtime.

# ---- MediaMTX credentials ---------------------------------------------------
# PUBLISH_PASS must equal PUBLISH_PASS in the capture box's run/config.env.
PUBLISH_USER=publisher
PUBLISH_PASS=change-me-publish
VIEW_USER=viewer
VIEW_PASS=change-me-view

# ---- web frontend -----------------------------------------------------------
APP_PASSWORD=pick-a-good-password
SESSION_SECRET=          # REQUIRED — generate: openssl rand -hex 32
SESSION_HOURS=720
WEB_PORT=8090            # host-side port, bound to 127.0.0.1 (Caddy fronts it)

# ---- HTTPS (only used with --profile caddy) ---------------------------------
DOMAIN=cam.example.com

# ---- stream / storage -------------------------------------------------------
STREAM_KEY=cam1
BITRATE=2000k            # H.264 output bitrate (MODE=copy transcode)

# ---- latency ----------------------------------------------------------------
# GOP_SECONDS is the biggest single lever on glass-to-glass delay. HLS can only
# cut a segment at a keyframe, so this — not hlsSegmentDuration — sets the true
# segment length. Keep it equal to hlsSegmentDuration in vps/mediamtx.yml (1s).
# Raising it saves bandwidth and costs latency, one for one.
GOP_SECONDS=1
FPS=15                   # camera is 1080p15; only used to size the GOP in frames
PRESET=veryfast          # x264 preset; slower = better quality/bit, more delay
RECORDINGS_DIR=./recordings
RECORD_KEEP=168h         # auto-purge after 7 days; 0s to keep forever

# ---- assignment reader (only used with --profile assignment) ----------------
GEMINI_API_KEY=          # https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-3.5-flash-lite   # 404 from Google? change this id
ASSIGNMENT_TOKEN=        # shared secret for POST /start, /capture etc.
ASSIGNMENT_PORT=8091
# Published on all interfaces by default so the glasses' document server can
# reach it (`ufw allow 8091/tcp`). ASSIGNMENT_BIND=127.0.0.1 keeps it local.
ASSIGNMENT_BIND=0.0.0.0
# Lets the reader pull stills from the gateway's /api/snapshot.jpg without a
# browser session. Required by the assignment profile.
SNAPSHOT_TOKEN=

# ---- ingest ports (host side) ----------------------------------------------
SRT_PORT=8890            # MODE=copy — what the phone pushes to
RTMP_PORT=1935           # MODE=h264 only

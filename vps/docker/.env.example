# Copy to .env — this is the ONLY file on the VPS holding secrets.
#   cp .env.example .env && nano .env
# Nothing else needs editing: mediamtx.yml keeps its CHANGE_ME placeholders and
# these values are injected over them at runtime.

# ---- MediaMTX credentials ---------------------------------------------------
# PUBLISH_PASS must equal PUBLISH_PASS in the capture box's run/config.env.
PUBLISH_USER=publisher
PUBLISH_PASS=change-me-publish
VIEW_USER=viewer
VIEW_PASS=change-me-view

# ---- web frontend -----------------------------------------------------------
APP_PASSWORD=pick-a-good-password
SESSION_SECRET=          # REQUIRED — generate: openssl rand -hex 32
SESSION_HOURS=720
WEB_PORT=8090            # host-side port, bound to 127.0.0.1 (Caddy fronts it)

# ---- HTTPS (only used with --profile caddy) ---------------------------------
DOMAIN=cam.example.com

# ---- stream / storage -------------------------------------------------------
STREAM_KEY=cam1
BITRATE=2000k            # H.264 output bitrate (MODE=copy transcode)
RECORDINGS_DIR=./recordings
RECORD_KEEP=168h         # auto-purge after 7 days; 0s to keep forever

# ---- ingest ports (host side) ----------------------------------------------
SRT_PORT=8890            # MODE=copy — what the phone pushes to
RTMP_PORT=1935           # MODE=h264 only
